    "custom_liquid_6gTJVL": {
      "type": "custom-liquid",
      "name": "t:sections.custom-liquid.presets.name",
      "settings": {
        "custom_liquid": "<section class=\"sf-benefits\">\n\n  <div class=\"sf-benefits-inner\">\n\n    <div class=\"sf-benefits-heading\">\n      <span>TRYGHED HOS SOFIE OG FREJA</span>\n      <h2>En tryg shoppingoplevelse</h2>\n    </div>\n\n\n    <!-- =========================\n         DESKTOP VERSION\n    ========================== -->\n\n    <div class=\"sf-benefits-desktop\">\n\n      <!-- PAYMENT -->\n      <div class=\"sf-benefit-card\">\n\n        <div class=\"sf-benefit-icon\">\n          <svg viewBox=\"0 0 32 32\" aria-hidden=\"true\">\n            <rect x=\"3.5\" y=\"7\" width=\"25\" height=\"18\" rx=\"3\"\n              fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.6\"/>\n            <path d=\"M4 12h24\"\n              fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.6\"/>\n            <path d=\"M8 19h6\"\n              fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.6\"\n              stroke-linecap=\"round\"/>\n          </svg>\n        </div>\n\n        <h3>Sikker betaling</h3>\n\n        <p>\n          Betal trygt og sikkert med MobilePay,\n          Visa eller Mastercard.\n        </p>\n\n        <span class=\"sf-benefit-note\">\n          Sikker og krypteret betaling\n        </span>\n\n      </div>\n\n\n      <!-- DELIVERY -->\n      <div class=\"sf-benefit-card\">\n\n        <div class=\"sf-benefit-icon\">\n          <svg viewBox=\"0 0 32 32\" aria-hidden=\"true\">\n            <path d=\"M4 9h15v14H4z\"\n              fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.6\"/>\n            <path d=\"M19 14h5l4 5v4h-9z\"\n              fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.6\"/>\n            <circle cx=\"10\" cy=\"24\" r=\"2.5\"\n              fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.6\"/>\n            <circle cx=\"24\" cy=\"24\" r=\"2.5\"\n              fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.6\"/>\n          </svg>\n        </div>\n\n        <h3>Hurtig levering i Danmark</h3>\n\n        <p>\n          Vi sender din ordre hurtigt og sikkert\n          med PostNord direkte til dig.\n        </p>\n\n        <span class=\"sf-benefit-note\">\n          Pålidelig levering med PostNord\n        </span>\n\n      </div>\n\n\n      <!-- RETURNS -->\n      <div class=\"sf-benefit-card\">\n\n        <div class=\"sf-benefit-icon\">\n          <svg viewBox=\"0 0 32 32\" aria-hidden=\"true\">\n            <path d=\"M9 10H5V6\"\n              fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.6\"\n              stroke-linecap=\"round\" stroke-linejoin=\"round\"/>\n            <path d=\"M5.5 10A12 12 0 1 1 5 21\"\n              fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.6\"\n              stroke-linecap=\"round\"/>\n            <path d=\"M11.5 17l3 3 6-7\"\n              fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.6\"\n              stroke-linecap=\"round\" stroke-linejoin=\"round\"/>\n          </svg>\n        </div>\n\n        <h3>30 dages returret</h3>\n\n        <p>\n          Passer det ikke helt? Du kan nemt\n          returnere eller ombytte dit køb.\n        </p>\n\n        <span class=\"sf-benefit-note\">\n          Shop med ro i maven\n        </span>\n\n      </div>\n\n    </div>\n\n\n\n    <!-- =========================\n         MOBILE ACCORDION\n    ========================== -->\n\n    <div class=\"sf-benefits-mobile\">\n\n      <!-- PAYMENT -->\n      <details class=\"sf-accordion\">\n\n        <summary>\n\n          <div class=\"sf-accordion-left\">\n\n            <div class=\"sf-mobile-icon\">\n              <svg viewBox=\"0 0 32 32\" aria-hidden=\"true\">\n                <rect x=\"3.5\" y=\"7\" width=\"25\" height=\"18\" rx=\"3\"\n                  fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.6\"/>\n                <path d=\"M4 12h24\"\n                  fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.6\"/>\n                <path d=\"M8 19h6\"\n                  fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.6\"\n                  stroke-linecap=\"round\"/>\n              </svg>\n            </div>\n\n            <span>Sikker betaling</span>\n\n          </div>\n\n          <div class=\"sf-plus\"></div>\n\n        </summary>\n\n        <div class=\"sf-accordion-content\">\n          <p>\n            Betal trygt og sikkert med MobilePay,\n            Visa eller Mastercard.\n          </p>\n\n          <span>Sikker og krypteret betaling</span>\n        </div>\n\n      </details>\n\n\n      <!-- DELIVERY -->\n      <details class=\"sf-accordion\">\n\n        <summary>\n\n          <div class=\"sf-accordion-left\">\n\n            <div class=\"sf-mobile-icon\">\n              <svg viewBox=\"0 0 32 32\" aria-hidden=\"true\">\n                <path d=\"M4 9h15v14H4z\"\n                  fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.6\"/>\n                <path d=\"M19 14h5l4 5v4h-9z\"\n                  fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.6\"/>\n                <circle cx=\"10\" cy=\"24\" r=\"2.5\"\n                  fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.6\"/>\n                <circle cx=\"24\" cy=\"24\" r=\"2.5\"\n                  fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.6\"/>\n              </svg>\n            </div>\n\n            <span>Hurtig levering i Danmark</span>\n\n          </div>\n\n          <div class=\"sf-plus\"></div>\n\n        </summary>\n\n        <div class=\"sf-accordion-content\">\n          <p>\n            Vi sender din ordre hurtigt og sikkert\n            med PostNord direkte til dig.\n          </p>\n\n          <span>Pålidelig levering med PostNord</span>\n        </div>\n\n      </details>\n\n\n      <!-- RETURNS -->\n      <details class=\"sf-accordion\">\n\n        <summary>\n\n          <div class=\"sf-accordion-left\">\n\n            <div class=\"sf-mobile-icon\">\n              <svg viewBox=\"0 0 32 32\" aria-hidden=\"true\">\n                <path d=\"M9 10H5V6\"\n                  fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.6\"\n                  stroke-linecap=\"round\" stroke-linejoin=\"round\"/>\n                <path d=\"M5.5 10A12 12 0 1 1 5 21\"\n                  fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.6\"\n                  stroke-linecap=\"round\"/>\n                <path d=\"M11.5 17l3 3 6-7\"\n                  fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.6\"\n                  stroke-linecap=\"round\" stroke-linejoin=\"round\"/>\n              </svg>\n            </div>\n\n            <span>30 dages returret</span>\n\n          </div>\n\n          <div class=\"sf-plus\"></div>\n\n        </summary>\n\n        <div class=\"sf-accordion-content\">\n          <p>\n            Passer det ikke helt? Du kan nemt\n            returnere eller ombytte dit køb.\n          </p>\n\n          <span>Shop med ro i maven</span>\n        </div>\n\n      </details>\n\n    </div>\n\n  </div>\n\n</section>\n\n\n<style>\n\n/* ===================================================\n   MAIN SECTION\n=================================================== */\n\n.sf-benefits {\n  width: 100%;\n  background: #f8f7f4;\n  color: #171717;\n  font-family: inherit;\n}\n\n.sf-benefits-inner {\n  width: 100%;\n  max-width: 1240px;\n  margin: 0 auto;\n  padding: 72px 30px 68px;\n  box-sizing: border-box;\n}\n\n\n/* ===================================================\n   HEADING\n=================================================== */\n\n.sf-benefits-heading {\n  text-align: center;\n  margin-bottom: 45px;\n}\n\n.sf-benefits-heading span {\n  display: block;\n  margin-bottom: 8px;\n\n  font-size: 10px;\n  line-height: 1.2;\n  font-weight: 700;\n\n  letter-spacing: 2px;\n\n  color: #57534e;\n}\n\n.sf-benefits-heading h2 {\n  margin: 0 !important;\n  padding: 0 !important;\n\n  font-family: inherit;\n\n  font-size: 28px;\n  line-height: 1.2;\n  font-weight: 600;\n\n  letter-spacing: -0.5px;\n\n  color: #171717;\n}\n\n\n/* ===================================================\n   DESKTOP GRID\n=================================================== */\n\n.sf-benefits-desktop {\n  display: grid;\n  grid-template-columns: repeat(3, 1fr);\n\n  gap: 18px;\n}\n\n\n/* CARD */\n\n.sf-benefit-card {\n  position: relative;\n\n  display: flex;\n  flex-direction: column;\n  align-items: center;\n\n  min-height: 310px;\n\n  padding: 34px 32px 30px;\n\n  text-align: center;\n\n  background: #ffffff;\n\n  border: 1px solid #e5e1da;\n  border-radius: 14px;\n\n  box-sizing: border-box;\n\n  transition:\n    transform .25s ease,\n    box-shadow .25s ease;\n}\n\n.sf-benefit-card:hover {\n  transform: translateY(-3px);\n\n  box-shadow:\n    0 9px 25px rgba(0,0,0,.055);\n}\n\n\n/* ICON */\n\n.sf-benefit-icon {\n  display: flex;\n  align-items: center;\n  justify-content: center;\n\n  width: 58px;\n  height: 58px;\n\n  margin-bottom: 22px;\n\n  border: 1px solid #ded9d1;\n  border-radius: 50%;\n\n  background: #f8f7f4;\n\n  color: #171717;\n}\n\n.sf-benefit-icon svg {\n  width: 27px;\n  height: 27px;\n\n  display: block;\n}\n\n\n/* TITLE */\n\n.sf-benefit-card h3 {\n  margin: 0 0 11px !important;\n  padding: 0 !important;\n\n  max-width: 260px;\n\n  font-family: inherit;\n\n  font-size: 19px;\n  line-height: 1.25;\n  font-weight: 600;\n\n  letter-spacing: -0.2px;\n\n  color: #171717;\n}\n\n\n/* DESCRIPTION */\n\n.sf-benefit-card p {\n  max-width: 285px;\n\n  margin: 0 auto 19px !important;\n\n  font-family: inherit;\n\n  font-size: 13.5px;\n  line-height: 1.55;\n  font-weight: 400;\n\n  color: #4a4742;\n}\n\n\n/* SMALL NOTE */\n\n.sf-benefit-note {\n  display: inline-block;\n\n  margin-top: auto;\n\n  padding-top: 17px;\n\n  border-top: 1px solid #ebe8e3;\n\n  width: 100%;\n\n  font-size: 10px;\n  line-height: 1.25;\n  font-weight: 700;\n\n  letter-spacing: .7px;\n\n  text-transform: uppercase;\n\n  color: #57534e;\n}\n\n\n/* ===================================================\n   MOBILE ACCORDION\n=================================================== */\n\n.sf-benefits-mobile {\n  display: none;\n}\n\n\n/* ===================================================\n   MOBILE\n=================================================== */\n\n@media screen and (max-width: 749px) {\n\n  .sf-benefits-inner {\n    padding: 35px 16px 34px;\n  }\n\n\n  /* SMALLER HEADING */\n\n  .sf-benefits-heading {\n    margin-bottom: 20px;\n  }\n\n  .sf-benefits-heading span {\n    margin-bottom: 6px;\n\n    font-size: 8.5px;\n    letter-spacing: 1.6px;\n  }\n\n  .sf-benefits-heading h2 {\n    font-size: 20px !important;\n    line-height: 1.2 !important;\n  }\n\n\n  /* HIDE DESKTOP */\n\n  .sf-benefits-desktop {\n    display: none;\n  }\n\n\n  /* SHOW MOBILE */\n\n  .sf-benefits-mobile {\n    display: flex;\n    flex-direction: column;\n\n    overflow: hidden;\n\n    background: #ffffff;\n\n    border: 1px solid #e3dfd8;\n    border-radius: 11px;\n  }\n\n\n  /* ACCORDION */\n\n  .sf-accordion {\n    width: 100%;\n\n    margin: 0;\n    padding: 0;\n\n    border-bottom: 1px solid #e8e4de;\n  }\n\n  .sf-accordion:last-child {\n    border-bottom: 0;\n  }\n\n\n  /* REMOVE DEFAULT ARROW */\n\n  .sf-accordion summary {\n    list-style: none;\n  }\n\n  .sf-accordion summary::-webkit-details-marker {\n    display: none;\n  }\n\n\n  /* SUMMARY ROW */\n\n  .sf-accordion summary {\n    display: flex;\n    align-items: center;\n    justify-content: space-between;\n\n    min-height: 61px;\n\n    padding: 10px 14px;\n\n    cursor: pointer;\n\n    box-sizing: border-box;\n\n    user-select: none;\n  }\n\n\n  .sf-accordion-left {\n    display: flex;\n    align-items: center;\n\n    gap: 12px;\n\n    min-width: 0;\n  }\n\n\n  .sf-accordion-left > span {\n    font-size: 14px;\n    line-height: 1.25;\n    font-weight: 600;\n\n    color: #191919;\n\n    text-align: left;\n  }\n\n\n  /* MOBILE ICON */\n\n  .sf-mobile-icon {\n    display: flex;\n    align-items: center;\n    justify-content: center;\n\n    width: 36px;\n    height: 36px;\n\n    min-width: 36px;\n\n    border-radius: 50%;\n\n    background: #f8f7f4;\n    border: 1px solid #e4e0d9;\n\n    color: #171717;\n  }\n\n  .sf-mobile-icon svg {\n    width: 19px;\n    height: 19px;\n\n    display: block;\n  }\n\n\n  /* PLUS */\n\n  .sf-plus {\n    position: relative;\n\n    width: 18px;\n    height: 18px;\n\n    margin-left: 12px;\n\n    flex: 0 0 18px;\n  }\n\n  .sf-plus:before,\n  .sf-plus:after {\n    content: \"\";\n\n    position: absolute;\n\n    top: 50%;\n    left: 50%;\n\n    background: #171717;\n\n    transform: translate(-50%, -50%);\n\n    transition: transform .2s ease;\n  }\n\n  .sf-plus:before {\n    width: 12px;\n    height: 1px;\n  }\n\n  .sf-plus:after {\n    width: 1px;\n    height: 12px;\n  }\n\n  .sf-accordion[open] .sf-plus:after {\n    transform:\n      translate(-50%, -50%)\n      rotate(90deg);\n\n    opacity: 0;\n  }\n\n\n  /* OPEN CONTENT */\n\n  .sf-accordion-content {\n    padding:\n      0 18px 17px 62px;\n\n    text-align: left;\n  }\n\n  .sf-accordion-content p {\n    margin: 0 0 8px !important;\n\n    font-size: 12.5px;\n    line-height: 1.5;\n    font-weight: 400;\n\n    color: #45413d;\n  }\n\n  .sf-accordion-content span {\n    display: block;\n\n    font-size: 9.5px;\n    line-height: 1.3;\n    font-weight: 700;\n\n    letter-spacing: .6px;\n\n    text-transform: uppercase;\n\n    color: #57534e;\n  }\n\n}\n\n</style>",
