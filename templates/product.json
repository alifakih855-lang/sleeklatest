      "name": "t:sections.custom-liquid.presets.name",
      "settings": {
        "custom_liquid": "<style>\n  .serena-summer-message {\n    --green: #054E4A;\n    --text: #172928;\n    --muted: #707976;\n    --line: #c9d8d6;\n    --page-bg: #f2f6fa;\n    --white: #ffffff;\n\n    width: 100%;\n    padding: 55px 20px;\n    background: var(--page-bg);\n\n    font-family: Arial, Helvetica, sans-serif;\n  }\n\n  .serena-summer-message * {\n    box-sizing: border-box;\n  }\n\n  .serena-summer-message .summer-inner {\n    display: grid;\n    grid-template-columns: 1fr 1fr;\n\n    width: 100%;\n    max-width: 1280px;\n\n    margin: 0 auto;\n\n    background: var(--white);\n  }\n\n  /* =========================\n     LEFT IMAGE\n  ========================= */\n\n  .serena-summer-message .summer-image {\n    min-height: 675px;\n    overflow: hidden;\n  }\n\n  .serena-summer-message .summer-image img {\n    display: block;\n\n    width: 100%;\n    height: 100%;\n\n    object-fit: cover;\n    object-position: center;\n  }\n\n  /* =========================\n     CONTENT\n  ========================= */\n\n  .serena-summer-message .summer-content {\n    display: flex;\n    align-items: center;\n    justify-content: center;\n\n    padding: 50px 58px;\n  }\n\n  .serena-summer-message .summer-content-inner {\n    width: 100%;\n    max-width: 510px;\n\n    text-align: center;\n  }\n\n  .serena-summer-message .summer-kicker {\n    margin: 0 0 17px;\n\n    color: var(--green);\n\n    font-size: 10px;\n    font-weight: 700;\n    line-height: 1.3;\n\n    letter-spacing: .19em;\n    text-transform: uppercase;\n  }\n\n  .serena-summer-message .summer-title {\n    margin: 0 0 22px;\n\n    color: var(--green);\n\n    font-family: Georgia, \"Times New Roman\", serif;\n\n    font-size: 47px;\n    font-weight: 400;\n    line-height: 1.05;\n\n    letter-spacing: -.025em;\n  }\n\n  .serena-summer-message .summer-copy {\n    margin: 0 0 16px;\n\n    color: var(--text);\n\n    font-size: 15px;\n    line-height: 1.65;\n  }\n\n  .serena-summer-message .summer-copy strong {\n    color: var(--green);\n    font-weight: 700;\n  }\n\n  /* =========================\n     OFFER MESSAGE\n  ========================= */\n\n  .serena-summer-message .summer-offer {\n    margin: 25px 0 21px;\n\n    padding: 17px 20px;\n\n    border-top: 1px solid var(--line);\n    border-bottom: 1px solid var(--line);\n\n    color: var(--green);\n\n    font-size: 13px;\n    line-height: 1.55;\n  }\n\n  .serena-summer-message .summer-offer strong {\n    font-weight: 700;\n  }\n\n  /* =========================\n     SIGNATURE\n  ========================= */\n\n  .serena-summer-message .summer-signature {\n    margin: 0 0 26px;\n  }\n\n  .serena-summer-message .summer-name {\n    margin: 0 0 5px;\n\n    color: #1c302f;\n\n    font-size: 11px;\n    font-weight: 700;\n    line-height: 1.3;\n\n    letter-spacing: .08em;\n    text-transform: uppercase;\n  }\n\n  .serena-summer-message .summer-role {\n    margin: 0;\n\n    color: #8a9290;\n\n    font-size: 10px;\n    line-height: 1.4;\n  }\n\n  /* =========================\n     BUTTON\n  ========================= */\n\n  .serena-summer-message .summer-button {\n    display: inline-flex;\n\n    min-width: 245px;\n    min-height: 50px;\n\n    align-items: center;\n    justify-content: center;\n\n    padding: 14px 25px;\n\n    background: var(--green);\n\n    color: #ffffff !important;\n\n    font-size: 11px;\n    font-weight: 700;\n    line-height: 1.2;\n\n    letter-spacing: .08em;\n    text-transform: uppercase;\n\n    text-decoration: none;\n\n    transition: opacity .2s ease;\n  }\n\n  .serena-summer-message .summer-button:hover {\n    opacity: .9;\n  }\n\n  /* =========================\n     MOBILE\n  ========================= */\n\n  @media (max-width: 749px) {\n\n    .serena-summer-message {\n      padding: 0;\n      background: #ffffff;\n    }\n\n    .serena-summer-message .summer-inner {\n      display: flex;\n      flex-direction: column;\n    }\n\n    .serena-summer-message .summer-image {\n      min-height: 0;\n\n      aspect-ratio: 1 / .78;\n    }\n\n    .serena-summer-message .summer-image img {\n      object-position: center 35%;\n    }\n\n    .serena-summer-message .summer-content {\n      padding: 31px 20px 35px;\n    }\n\n    .serena-summer-message .summer-content-inner {\n      max-width: 430px;\n    }\n\n    .serena-summer-message .summer-kicker {\n      margin-bottom: 12px;\n\n      font-size: 9px;\n    }\n\n    .serena-summer-message .summer-title {\n      margin-bottom: 16px;\n\n      font-size: 31px;\n      line-height: 1.05;\n    }\n\n    .serena-summer-message .summer-copy {\n      margin-bottom: 11px;\n\n      font-size: 14px;\n      line-height: 1.5;\n    }\n\n    .serena-summer-message .summer-offer {\n      margin: 19px 0 17px;\n\n      padding: 13px 10px;\n\n      font-size: 12px;\n      line-height: 1.45;\n    }\n\n    .serena-summer-message .summer-signature {\n      margin-bottom: 20px;\n    }\n\n    .serena-summer-message .summer-button {\n      width: 100%;\n\n      min-height: 49px;\n\n      font-size: 10.5px;\n    }\n  }\n\n</style>\n\n\n<section class=\"serena-summer-message\">\n\n  <div class=\"summer-inner\">\n\n\n    <!-- =========================\n         LEFT IMAGE\n         REPLACE URL\n    ========================== -->\n\n    <div class=\"summer-image\">\n\n      <img\n        src=\"https://cdn.shopify.com/s/files/1/0994/5507/4598/files/0a52dee1-922f-4e2b-b555-c0e5b91b4982.png\"\n        alt=\"Serena Rossi, fondatrice di Serena Roma\"\n        loading=\"lazy\"\n      >\n\n    </div>\n\n\n\n    <!-- =========================\n         RIGHT CONTENT\n    ========================== -->\n\n    <div class=\"summer-content\">\n\n      <div class=\"summer-content-inner\">\n\n\n        <p class=\"summer-kicker\">\n          Un messaggio da Serena Roma\n        </p>\n\n\n        <h2 class=\"summer-title\">\n          Un ultimo tocco d'estate\n        </h2>\n\n\n        <p class=\"summer-copy\">\n          Questa stagione è stata piena di colori,\n          nuovi arrivi e momenti meravigliosi condivisi insieme a voi.\n        </p>\n\n\n        <p class=\"summer-copy\">\n          Ora che l'estate volge lentamente al termine,\n          voglio fare spazio alla nuova stagione\n          e salutare questi ultimi giorni nel modo più bello.\n        </p>\n\n\n        <p class=\"summer-copy\">\n          Per questo abbiamo dato il via alla nostra\n          <strong>svendita di fine estate</strong>,\n          con una selezione di articoli a prezzi speciali.\n        </p>\n\n\n        <div class=\"summer-offer\">\n          Per pochi giorni, puoi approfittare di\n          <strong>sconti fino al 70%</strong>\n          sui tuoi preferiti della stagione.\n        </div>\n\n\n        <div class=\"summer-signature\">\n\n          <p class=\"summer-name\">\n            — Serena Rossi\n          </p>\n\n          <p class=\"summer-role\">\n            Fondatrice di Serena Roma\n          </p>\n\n        </div>\n\n\n        <a\n          class=\"summer-button\"\n          href=\"/collections/all\"\n        >\n          Scopri la svendita di fine estate\n        </a>\n\n\n      </div>\n\n    </div>\n\n\n  </div>\n\n</section>",
        "color_scheme": "",
        "padding_top": 50,
        "padding_bottom": 50,
        "custom_class": ""
      }
    },
