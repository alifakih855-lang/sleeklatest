: absolute;\n\n    top: 2px;\n    left: 0;\n\n    width: 30px;\n    height: 30px;\n\n    display: grid;\n\n    place-items: center;\n\n    border: 1px solid var(--sr-ink);\n\n    border-radius: 50%;\n\n    font-family: Arial, Helvetica, sans-serif;\n\n    font-size: 12px;\n    font-weight: 700;\n  }\n\n  /* SIGNATURE */\n\n  #serena-advertorial .sr-signature {\n    margin-top: 3px;\n\n    font-size: 29px;\n\n    line-height: 1;\n\n    font-style: italic;\n  }\n\n  /* FINAL PRODUCT CARD */\n\n  #serena-advertorial .sr-product-card {\n    display: grid;\n\n    grid-template-columns: 235px 1fr;\n\n    gap: 30px;\n\n    align-items: start;\n\n    margin-top: 52px;\n\n    padding: 35px 0;\n\n    border-top: 1px solid var(--sr-line);\n    border-bottom: 1px solid var(--sr-line);\n  }\n\n  #serena-advertorial .sr-product-title {\n    margin: 0 0 10px;\n\n    font-family: Georgia, \"Times New Roman\", Times, serif;\n\n    font-size: 26px;\n    font-weight: 600;\n\n    line-height: 1.2;\n\n    letter-spacing: -0.02em;\n  }\n\n  #serena-advertorial .sr-rating {\n    margin: 0 0 14px;\n\n    font-family: Arial, Helvetica, sans-serif;\n\n    font-size: 13px;\n\n    line-height: 1.4;\n\n    color: var(--sr-muted);\n  }\n\n  #serena-advertorial .sr-price {\n    display: flex;\n\n    align-items: baseline;\n\n    gap: 10px;\n\n    margin: 0 0 19px;\n\n    font-family: Arial, Helvetica, sans-serif;\n  }\n\n  #serena-advertorial .sr-price-old {\n    font-size: 15px;\n\n    color: #8a857e;\n\n    text-decoration: line-through;\n  }\n\n  #serena-advertorial .sr-price-new {\n    font-size: 24px;\n\n    font-weight: 700;\n\n    color: var(--sr-ink);\n  }\n\n  #serena-advertorial .sr-benefits {\n    margin: 0 0 23px;\n\n    padding: 0;\n\n    list-style: none;\n  }\n\n  #serena-advertorial .sr-benefits li {\n    position: relative;\n\n    margin: 0 0 9px;\n\n    padding-left: 20px;\n\n    font-family: Arial, Helvetica, sans-serif;\n\n    font-size: 13px;\n\n    line-height: 1.5;\n\n    color: #383633;\n  }\n\n  #serena-advertorial .sr-benefits li::before {\n    content: \"✓\";\n\n    position: absolute;\n\n    left: 0;\n    top: 0;\n\n    font-weight: 700;\n  }\n\n  #serena-advertorial .sr-sale-note {\n    margin: 14px 0 0;\n\n    text-align: center;\n\n    font-family: Arial, Helvetica, sans-serif;\n\n    font-size: 11px;\n\n    line-height: 1.45;\n\n    color: var(--sr-muted);\n  }\n\n  /* DISCLOSURE */\n\n  #serena-advertorial .sr-editorial-note {\n    margin: 26px 0 0;\n\n    padding: 20px 0 0;\n\n    border-top: 1px solid var(--sr-line);\n\n    font-family: Arial, Helvetica, sans-serif;\n\n    font-size: 11px;\n\n    line-height: 1.65;\n\n    color: var(--sr-muted);\n  }\n\n  #serena-advertorial .sr-brandline {\n    margin-top: 13px;\n\n    font-family: Arial, Helvetica, sans-serif;\n\n    font-size: 11px;\n\n    line-height: 1.6;\n\n    color: var(--sr-muted);\n  }\n\n  #serena-advertorial .sr-ad-disclosure {\n    margin-top: 16px;\n\n    padding: 14px 16px;\n\n    background: var(--sr-soft);\n\n    font-family: Arial, Helvetica, sans-serif;\n\n    font-size: 11px;\n\n    line-height: 1.55;\n\n    color: #5f5b55;\n  }\n\n  /* MOBILE */\n\n  @media (max-width: 749px) {\n    #serena-advertorial .sr-shell {\n      width: min(100% - 28px, 760px);\n\n      padding: 34px 0 52px;\n    }\n\n    #serena-advertorial h1 {\n      font-size: 39px;\n\n      line-height: 1.04;\n    }\n\n    #serena-advertorial .sr-deck {\n      font-size: 17px;\n\n      line-height: 1.55;\n    }\n\n    #serena-advertorial .sr-author {\n      padding: 22px 0;\n\n      margin-top: 23px;\n    }\n\n    #serena-advertorial .sr-article {\n      padding-top: 28px;\n    }\n\n    #serena-advertorial .sr-article p,\n    #serena-advertorial .sr-numbered li {\n      font-size: 18px;\n\n      line-height: 1.68;\n    }\n\n    #serena-advertorial .sr-article h2 {\n      margin-top: 38px;\n\n      font-size: 28px;\n    }\n\n    #serena-advertorial .sr-quote {\n      padding-left: 18px;\n\n      font-size: 21px;\n    }\n\n    #serena-advertorial .sr-image-placeholder,\n    #serena-advertorial .sr-image-placeholder.sr-landscape {\n      min-height: 0;\n\n      aspect-ratio: 4 / 3;\n    }\n\n    #serena-advertorial .sr-product-card {\n      grid-template-columns: 1fr;\n\n      gap: 23px;\n\n      padding: 29px 0;\n    }\n\n    #serena-advertorial .sr-product-title {\n      font-size: 25px;\n    }\n  }\n\n  @media (max-width: 390px) {\n    #serena-advertorial h1 {\n      font-size: 35px;\n    }\n\n    #serena-advertorial .sr-shell {\n      width: calc(100% - 24px);\n    }\n  }\n</style>\n\n\n<section id=\"serena-advertorial\">\n\n  <div class=\"sr-shell\">\n\n    <div class=\"sr-kicker\">\n      Una lettera da una lettrice\n    </div>\n\n\n    <h1>\n      Per anni ho nascosto il cesto della biancheria dietro la porta.\n      Poi mia nipote mi ha fatto una domanda che non ho più dimenticato.\n    </h1>\n\n\n    <p class=\"sr-deck\">\n      Una piccola storia da Roma su uno di quegli oggetti di casa\n      che smettiamo di vedere, finché qualcuno non ce lo fa guardare\n      con occhi nuovi.\n    </p>\n\n\n    <div class=\"sr-author\">\n\n      <!-- FOTO TONDA ELENA -->\n      <div class=\"sr-author-photo\">\n      </div>\n\n      <div>\n\n        <p class=\"sr-author-name\">\n          Elena Conti\n        </p>\n\n        <p class=\"sr-author-meta\">\n          Roma · 67 anni · Agosto 2026\n        </p>\n\n      </div>\n\n    </div>\n\n\n    <article class=\"sr-article\">\n\n\n      <p>\n        Non avevo mai pensato di scrivere una cosa del genere.\n        Non sono una giornalista, e di certo non sono il tipo di persona\n        che dà consigli agli altri su come tenere la propria casa.\n      </p>\n\n\n      <p>\n        Ma qualche settimana fa tre persone diverse mi hanno chiesto\n        la stessa cosa durante una cena.\n      </p>\n\n\n      <p>\n        Non del tavolo.\n        Non dei bicchieri nuovi.\n        Non delle tende.\n      </p>\n\n\n      <p>\n        Mi hanno chiesto del mio cesto della biancheria.\n      </p>\n\n\n      <p>\n        La storia, però, era iniziata prima, quando mia nipote Chiara\n        era venuta a dormire da me.\n      </p>\n\n\n      <p>\n        Entrando in bagno mi ha vista spostare, quasi automaticamente,\n        il vecchio cesto dietro la porta.\n      </p>\n\n\n      <div class=\"sr-quote\">\n        “Nonna, perché ogni volta che arriva qualcuno nascondi proprio quella cosa?”\n      </div>\n\n\n      <p>\n        Ho riso.\n      </p>\n\n\n      <p>\n        Ma aveva ragione.\n      </p>\n\n\n      <p>\n        Era un vecchio cesto di plastica color beige, graffiato,\n        leggermente storto e ormai opaco sui bordi.\n      </p>\n\n\n      <p>\n        Lo avevo comprato pensando che fosse una soluzione provvisoria.\n      </p>\n\n\n      <p>\n        Il “provvisorio” era durato quasi dieci anni.\n      </p>\n\n\n      <figure class=\"sr-figure\">\n\n        <!--\n        IMMAGINE 1\n        VECCHIO CESTO / FOTO PRIMA\n\n        Sostituisci questo div con:\n\n        <img src=\"URL-IMMAGINE\" alt=\"\">\n        -->\n\n        <div\n          class=\"sr-image-placeholder sr-landscape\"\n          aria-hidden=\"true\">\n        </div>\n\n\n        <figcaption class=\"sr-caption\">\n          Il vecchio cesto.\n          Funzionava ancora, ma non volevo mai lasciarlo in vista.\n        </figcaption>\n\n      </figure>\n\n\n\n      <h2>\n        Come ci si abitua alle cose brutte\n      </h2>\n\n\n      <p>\n        Ci sono oggetti che scegliamo con attenzione:\n        una lampada, un vaso, una tovaglia.\n      </p>\n\n\n      <p>\n        E poi ce ne sono altri che compriamo soltanto perché “servono”.\n      </p>\n\n\n      <p>\n        Il cesto della biancheria, per me,\n        apparteneva alla seconda categoria.\n      </p>\n\n\n      <p>\n        Così finiamo per accettare plastica rigida,\n        reti pieghevoli che si afflosciano\n        e colori che non avremmo mai scelto\n        per nessun altro angolo della casa.\n      </p>\n\n\n      <p>\n        Non perché ci piacciano.\n      </p>\n\n\n      <p>\n        Ma perché nessuno ci ha mai fatto pensare\n        che esistesse un'alternativa.\n      </p>\n\n\n\n      <h2>\n        La cosa che avevo capito male\n      </h2>\n\n\n      <p>\n        Ero convinta che un cesto dovesse essere brutto\n        per essere pratico.\n      </p>\n\n\n      <p>\n        Pensavo:\n        se è in tessuto non starà in piedi,\n        sarà difficile da usare\n        e finirà per perdere forma.\n      </p>\n\n\n      <p>\n        Poi ho scoperto i cesti trapuntati strutturati.\n      </p>\n\n\n      <p>\n        Morbidi al tatto,\n        ma abbastanza sostenuti da restare dritti\n        anche quando sono vuoti.\n      </p>\n\n\n      <p>\n        Si possono piegare quando non servono,\n        hanno manici robusti e,\n        soprattutto,\n        non sembrano qualcosa da nascondere.\n      </p>\n\n\n      <p>\n        Mi è sembrata una banalità.\n      </p>\n\n\n      <p>\n        E forse lo è.\n      </p>\n\n\n      <p>\n        Ma a 67 anni ho scoperto che\n        <strong>\n          pratico e bello non devono per forza essere due cose separate.\n        </strong>\n      </p>\n\n\n\n      <div class=\"sr-cta-wrap\">\n\n        <a\n          class=\"sr-cta\"\n          href=\"{{ cta_url }}\">\n\n          Scopri la collezione Serena Roma\n\n        </a>\n\n      </div>\n\n\n\n      <h2>\n        Quello che ho scelto io\n      </h2>\n\n\n      <p>\n        Cercando qualcosa di meno anonimo\n        sono arrivata su Serena Roma.\n      </p>\n\n\n      <p>\n        Il modello che mi ha colpita per primo\n        è stato <strong>Corallo</strong>.\n      </p>\n\n\n      <p>\n        Un cesto trapuntato con un motivo ispirato al mare,\n        pensato per sembrare parte della stanza\n        e non un oggetto da tollerare in un angolo.\n      </p>\n\n\n\n      <figure class=\"sr-figure\">\n\n        <!--\n        IMMAGINE 2\n        PRODOTTO APPENA ARRIVATO\n        -->\n\n        <div\n          class=\"sr-image-placeholder sr-landscape\"\n          aria-hidden=\"true\">\n        </div>\n\n\n        <figcaption class=\"sr-caption\">\n          Il giorno in cui è arrivato.\n          Non pensavo che un cesto potesse cambiare\n          così tanto l'aspetto di una stanza.\n        </figcaption>\n\n      </figure>\n\n\n\n      <p>\n        La struttura resta in piedi da sola.\n      </p>\n\n\n      <p>\n        I manici sono comodi anche quando è pieno\n        e il tessuto trapuntato gli dà un aspetto\n        molto più curato del classico contenitore di plastica.\n      </p>\n\n\n      <p>\n        La parte che preferisco, però,\n        è semplicemente questa:\n      </p>\n\n\n      <p>\n        <strong>\n          posso lasciarlo dove sta.\n        </strong>\n      </p>\n\n\n      <p>\n        Non devo più ricordarmi di spostarlo\n        prima che suoni il campanello.\n      </p>\n\n\n\n      <h2>\n        Quando sono venute le mie amiche\n      </h2>\n\n\n      <p>\n        Adesso lo tengo in camera,\n        vicino all'armadio.\n      </p>\n\n\n      <p>\n        È un posto in cui il vecchio cesto\n        non sarebbe mai rimasto quando avevo ospiti.\n      </p>\n\n\n\n      <figure class=\"sr-figure\">\n\n        <!--\n        IMMAGINE 3\n        CESTO IN CAMERA\n        -->\n\n        <div\n          class=\"sr-image-placeholder sr-landscape\"\n          aria-hidden=\"true\">\n        </div>\n\n      </figure>\n\n\n\n      <p>\n        Durante una cena,\n        Carla — che di solito nota solo il cibo —\n        mi ha chiesto dove lo avessi trovato.\n      </p>\n\n\n      <p>\n        Poco dopo me lo ha chiesto anche mia sorella.\n      </p>\n\n\n      <p>\n        Chiara, invece,\n        si è limitata a sorridere,\n        soddisfatta di aver “risolto”\n        il problema che aveva sollevato lei.\n      </p>\n\n\n      <p>\n        Non ricordo che qualcuno\n        mi avesse mai chiesto informazioni\n        su un cesto della biancheria.\n      </p>\n\n\n      <p>\n        Quella sera è successo più volte.\n      </p>\n\n\n\n      <figure class=\"sr-figure\">\n\n        <!--\n        IMMAGINE 4\n        CESTO IN BAGNO\n        -->\n\n        <div\n          class=\"sr-image-placeholder sr-landscape\"\n          aria-hidden=\"true\">\n        </div>\n\n\n        <figcaption class=\"sr-caption\">\n          In bagno,\n          finalmente lasciato in vista.\n        </figcaption>\n\n      </figure>\n\n\n\n      <h2>\n        Tre cose che ho capito usandolo\n      </h2>\n\n\n      <ol class=\"sr-numbered\">\n\n        <li>\n          <strong>\n            Resta ordinato anche quando è vuoto.\n          </strong>\n\n          Non si accascia e non dà\n          quell'impressione di disordine\n          tipica dei cesti morbidi economici.\n        </li>\n\n\n        <li>\n          <strong>\n            Quando serve spazio, si piega.\n          </strong>\n\n          Posso riporlo sopra l'armadio\n          o in un angolo senza dover trovare posto\n          per un contenitore rigido.\n        </li>\n\n\n        <li>\n          <strong>\n            Se un oggetto ti piace,\n            finisci per usarlo meglio.\n          </strong>\n\n          Sembra una sciocchezza,\n          ma da quando è lì\n          la biancheria finisce davvero dentro il cesto\n          e non sulla sedia accanto.\n        </li>\n\n      </ol>\n\n\n\n      <h2>\n        La questione del prezzo\n      </h2>\n\n\n      <p>\n        Questa è stata la parte\n        su cui ho esitato di più.\n      </p>\n\n\n      <p>\n        Un cesto della biancheria\n        non è l'acquisto per cui pensavo\n        di voler spendere qualcosa in più.\n      </p>\n\n\n      <p>\n        Poi ho contato quanti cesti economici\n        avevo sostituito negli anni.\n      </p>\n\n\n      <p>\n        Uno crepato sul bordo.\n      </p>\n\n\n      <p>\n        Uno con un manico rotto.\n      </p>\n\n\n      <p>\n        Uno che non stava mai dritto.\n      </p>\n\n\n      <p>\n        Tutti “economici”.\n      </p>\n\n\n      <p>\n        Tutti finiti per essere ricomprati.\n      </p>\n\n\n      <p>\n        A quel punto ho smesso di confrontarlo\n        con il cesto più economico che potevo trovare.\n      </p>\n\n\n      <p>\n        Ho iniziato a confrontarlo\n        con un oggetto che avrei voluto\n        tenere davvero in casa.\n      </p>\n\n\n      <p>\n        Per me,\n        la differenza era tutta lì.\n      </p>\n\n\n\n      {% if show_reviews == true %}\n\n        <p>\n          Prima di ordinare ho fatto quello\n          che faccio sempre:\n          ho letto le recensioni.\n        </p>\n\n\n        <p>\n          La valutazione attuale è di\n          <strong>{{ review_rating }}/5</strong>\n          su\n          <strong>{{ review_count }}</strong>\n          recensioni.\n        </p>\n\n      {% endif %}\n\n\n\n      <div class=\"sr-cta-wrap\">\n\n        <a\n          class=\"sr-cta\"\n          href=\"{{ cta_url }}\">\n\n          Guarda tutti i modelli disponibili\n\n        </a>\n\n      </div>\n\n\n\n      <h2>\n        Cosa ti direi se fossimo sedute insieme\n        a prendere un caffè\n      </h2>\n\n\n      <p>\n        Ti direi di guardare\n        il cesto che hai adesso.\n      </p>\n\n\n      <p>\n        Non per chiederti se “funziona”.\n      </p>\n\n\n      <p>\n        Probabilmente sì.\n      </p>\n\n\n      <p>\n        Ma per chiederti se è qualcosa\n        che hai scelto davvero\n        o soltanto qualcosa\n        a cui ti sei abituata.\n      </p>\n\n\n      <p>\n        La casa è fatta soprattutto\n        di piccole cose\n        che vediamo ogni giorno.\n      </p>\n\n\n      <p>\n        Quando una di quelle piccole cose\n        smette di infastidirti\n        e comincia persino a piacerti,\n        la differenza sembra\n        sorprendentemente grande.\n      </p>\n\n\n      <p>\n        Io il vecchio cesto\n        l'ho salutato senza alcun rimpianto.\n      </p>\n\n\n      <p class=\"sr-signature\">\n        Elena\n      </p>\n\n\n\n      <div class=\"sr-product-card\">\n\n\n        <div>\n\n          <!--\n          IMMAGINE 5\n          FOTO PRODOTTO BOX FINALE\n          -->\n\n          <div\n            class=\"sr-image-placeholder sr-product-image\"\n            aria-hidden=\"true\">\n          </div>\n\n        </div>\n\n\n\n        <div>\n\n\n          <h3 class=\"sr-product-title\">\n            {{ product_name }}\n          </h3>\n\n\n          {% if show_reviews == true %}\n\n            <p class=\"sr-rating\">\n              ★★★★☆\n              {{ review_rating }}/5\n              ·\n              {{ review_count }}\n              recensioni\n            </p>\n\n          {% endif %}\n\n\n          <div class=\"sr-price\">\n\n            <span class=\"sr-price-old\">\n              {{ compare_price }}\n            </span>\n\n            <span class=\"sr-price-new\">\n              {{ current_price }}\n            </span>\n\n          </div>\n\n\n\n          <ul class=\"sr-benefits\">\n\n            <li>\n              Tessuto trapuntato morbido ma strutturato\n            </li>\n\n            <li>\n              Resta in piedi da solo, pieno o vuoto\n            </li>\n\n            <li>\n              Manici resistenti per trasportarlo facilmente\n            </li>\n\n            <li>\n              Si piega quando non viene utilizzato\n            </li>\n\n            <li>\n              Disponibile in più misure e fantasie\n            </li>\n\n            <li>\n              {{ delivery_note }}\n            </li>\n\n          </ul>\n\n\n\n          <a\n            class=\"sr-cta\"\n            href=\"{{ cta_url }}\">\n\n            Scopri la collezione\n\n          </a>\n\n\n          <p class=\"sr-sale-note\">\n            Disponibilità e prezzi possono variare\n            in base al modello selezionato.\n          </p>\n\n\n        </div>\n\n\n      </div>\n\n\n\n      <p class=\"sr-editorial-note\">\n\n        <strong>Elena Conti</strong>\n        è un personaggio narrativo creato\n        per questa pagina pubblicitaria\n        e utilizzato per rappresentare\n        una situazione quotidiana\n        e spiegare le caratteristiche del prodotto.\n\n      </p>\n\n\n      <p class=\"sr-brandline\">\n        Serena Roma · {{ delivery_note }}\n      </p>\n\n\n      <div class=\"sr-ad-disclosure\">\n\n        Questa pagina è una comunicazione pubblicitaria\n        di Serena Roma.\n\n        Verifica sempre prezzo,\n        disponibilità,\n        condizioni di consegna\n        e politica di reso\n        nella pagina prodotto prima dell'acquisto.\n\n      </div>\n\n\n    </article>\n\n  </div>\n\n</section>",
