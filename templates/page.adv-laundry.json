      "settings": {
        "custom_liquid": "{% comment %}\nSERENA ROMA — ADVERTORIAL PAGE\nReplace the CTA URL, product details, prices, and images when ready.\n{% endcomment %}\n\n{% assign cta_url = '/collections/all' %}\n{% assign product_name = 'CORALLO | Cesto Armonia Costiera' %}\n{% assign current_price = '€34,95' %}\n{% assign compare_price = '€69,95' %}\n{% assign delivery_note = 'Spedizione tracciata in Italia' %}\n\n{% assign show_reviews = false %}\n{% assign review_rating = '4,2' %}\n{% assign review_count = '300+' %}\n\n<style>\n\n#shopify-section-header,\n#shopify-section-footer,\n.shopify-section-group-header-group,\n.shopify-section-group-footer-group,\nheader,\nfooter {\n  display: none !important;\n}\n\n  #serena-advertorial {\n    --sr-ink: #1d1d1b;\n    --sr-muted: #6c6862;\n    --sr-line: #dedbd6;\n    --sr-soft: #f5f2ed;\n    --sr-soft-2: #ece7df;\n    --sr-button: #1e1e1c;\n    --sr-white: #ffffff;\n\n    background: var(--sr-white);\n    color: var(--sr-ink);\n    width: 100%;\n    margin: 0;\n    padding: 0;\n\n    font-family: Georgia, \"Times New Roman\", Times, serif;\n\n    -webkit-font-smoothing: antialiased;\n    text-rendering: optimizeLegibility;\n  }\n\n  #serena-advertorial * {\n    box-sizing: border-box;\n  }\n\n  #serena-advertorial a {\n    color: inherit;\n    text-decoration: none;\n  }\n\n  #serena-advertorial .sr-shell {\n    width: min(100% - 36px, 760px);\n    margin: 0 auto;\n    padding: 58px 0 72px;\n  }\n\n  /* TOP LABEL */\n\n  #serena-advertorial .sr-kicker {\n    margin: 0 0 18px;\n\n    font-family: Arial, Helvetica, sans-serif;\n    font-size: 12px;\n    font-weight: 700;\n    line-height: 1.3;\n\n    letter-spacing: 0.14em;\n    text-transform: uppercase;\n\n    color: var(--sr-muted);\n  }\n\n  /* MAIN HEADLINE */\n\n  #serena-advertorial h1 {\n    margin: 0;\n\n    max-width: 735px;\n\n    font-family: Georgia, \"Times New Roman\", Times, serif;\n    font-size: clamp(38px, 6.1vw, 61px);\n    font-weight: 500;\n\n    line-height: 1.02;\n    letter-spacing: -0.035em;\n\n    color: var(--sr-ink);\n  }\n\n  #serena-advertorial .sr-deck {\n    max-width: 650px;\n\n    margin: 22px 0 0;\n\n    font-size: 19px;\n    line-height: 1.55;\n\n    color: var(--sr-muted);\n  }\n\n  /* AUTHOR */\n\n  #serena-advertorial .sr-author {\n    display: flex;\n    align-items: center;\n\n    gap: 13px;\n\n    padding: 28px 0 30px;\n    margin-top: 28px;\n\n    border-top: 1px solid var(--sr-line);\n    border-bottom: 1px solid var(--sr-line);\n  }\n\n  #serena-advertorial .sr-author-photo {\n    width: 54px;\n    height: 54px;\n\n    flex: 0 0 54px;\n\n    border-radius: 50%;\n\n    background: var(--sr-soft-2);\n\n    overflow: hidden;\n  }\n\n  #serena-advertorial .sr-author-photo img {\n    width: 100%;\n    height: 100%;\n\n    object-fit: cover;\n\n    display: block;\n  }\n\n  #serena-advertorial .sr-author-name {\n    margin: 0 0 3px;\n\n    font-family: Arial, Helvetica, sans-serif;\n    font-size: 14px;\n    font-weight: 700;\n\n    line-height: 1.2;\n  }\n\n  #serena-advertorial .sr-author-meta {\n    margin: 0;\n\n    font-family: Arial, Helvetica, sans-serif;\n    font-size: 12px;\n\n    line-height: 1.35;\n\n    color: var(--sr-muted);\n  }\n\n  /* ARTICLE */\n\n  #serena-advertorial .sr-article {\n    padding-top: 34px;\n  }\n\n  #serena-advertorial .sr-article p {\n    margin: 0 0 24px;\n\n    font-size: 19px;\n    line-height: 1.72;\n\n    letter-spacing: -0.006em;\n  }\n\n  #serena-advertorial .sr-article h2 {\n    margin: 44px 0 18px;\n\n    font-family: Georgia, \"Times New Roman\", Times, serif;\n    font-size: 31px;\n    font-weight: 600;\n\n    line-height: 1.16;\n    letter-spacing: -0.025em;\n  }\n\n  /* QUOTE */\n\n  #serena-advertorial .sr-quote {\n    margin: 31px 0;\n\n    padding: 3px 0 3px 22px;\n\n    border-left: 3px solid var(--sr-ink);\n\n    font-size: 24px;\n    font-style: italic;\n\n    line-height: 1.48;\n  }\n\n  /* IMAGES */\n\n  #serena-advertorial .sr-figure {\n    m